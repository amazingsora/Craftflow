# Craftflow 環境設定範本
# 複製此檔為 .env 並依本機環境調整

# ── AI 服務位址 ────────────────────────────────────────────────
# 本機直跑（start.bat）用 localhost（預設）
# Docker 環境改為 host.docker.internal
OLLAMA_BASE=http://localhost:11434
COMFYUI_BASE=http://localhost:8188

# ── 模型選擇 ───────────────────────────────────────────────────
# 設定「啟動時預設模型」；啟動後可在前端「設定」頁面即時切換，無需重啟
# 留空或省略此兩行 = 使用程式內建預設（llama3.2:3b / moondream）
#
# 依 VRAM 選擇（參考 doc/setup_guide.md 硬體對照表）：
#   4–6GB VRAM  → TEXT_MODEL=llama3.2:3b    VISION_MODEL=moondream
#   8GB   VRAM  → TEXT_MODEL=llama3.2:3b    VISION_MODEL=llava:7b
#   12GB  VRAM  → TEXT_MODEL=dolphin-llama3 VISION_MODEL=llava:7b
#   16GB+ VRAM  → TEXT_MODEL=dolphin-llama3 VISION_MODEL=qwen2.5vl:7b
#   24GB+ VRAM  → TEXT_MODEL=qwen2.5:14b   VISION_MODEL=qwen2.5vl:7b
#
# TEXT_MODEL=llama3.2:3b
# VISION_MODEL=moondream

# ── LoRA 訓練設定 ───────────────────────────────────────────────
# TRAINING_RUNNER_MODE: local（本機 subprocess）| remote（Docker 模式，需 host agent）
TRAINING_RUNNER_MODE=local
# kohya_ss 安裝目錄（local 模式使用）
KOHYA_PATH=C:\kohya_ss
# 訓練圖片上傳暫存目錄（後端本地路徑）
TRAINING_IMAGES_DIR=D:\sp\Craftflow\data\training_images
# ComfyUI LoRA 目錄（訓練完成後自動複製）
COMFYUI_LORAS_DIR=C:\ComfyUI\models\loras

# ── Personal Style Preset（個人風格預設，預設關閉）──────────────────────────
# 啟用後，角色生圖時會自動附加指定畫風標籤與使用個人負向提示詞
# 適合固定使用特定畫風（如 Blue Archive / Project Sekai）的個人用戶
#
# PERSONAL_STYLE_ENABLED=false
# PERSONAL_STYLE_EXTRA_TAGS=Blue Archive style, anime game illustration, clean lineart, soft shading, large expressive eyes, delicate face, pale skin, light blush, pastel tone, crisp edges, bright highlights, high detail
# PERSONAL_STYLE_EXTRA_TAGS=Dragon Ball style, Akira Toriyama style, retro anime, bold lineart, cel shading, sharp eyes, muscular definition

# PERSONAL_NEGATIVE_ENABLED=false
# PERSONAL_NEGATIVE=lowres, bad quality, worst quality, sketch, rough lineart, photorealistic, 3d, realistic, heavy rendering, oily skin, blurry face, deformed hands, extra fingers, bad anatomy, watermark, signature, text
