# Craftflow 環境設定範本
# 複製此檔為 .env 並依本機環境調整
# 此檔不進 git（見 .gitignore）

# ── AI 服務位址 ────────────────────────────────────────────────
# 本機直跑（start.bat）用 localhost
# Docker 環境改為 host.docker.internal
OLLAMA_BASE=http://localhost:11434
COMFYUI_BASE=http://localhost:8188
# 以下三項由 installer/CraftflowSetup.exe 寫入（後端目前只讀 COMFYUI_LORAS_DIR）
# COMFYUI_DIR=D:\ComfyUI_portable\ComfyUI         # ComfyUI 本體目錄（含 main.py）
# COMFYUI_LAUNCHER=D:\ComfyUI_portable\run_nvidia_gpu.bat

# ── 模型選擇（啟動預設；前端「設定」頁可即時切換）──────────────
# 省略 = 使用程式內建預設（llama3.2:3b / moondream）
# 依 VRAM 參考 doc/setup_guide.md 硬體對照表
TEXT_MODEL=llama3.2:3b
VISION_MODEL=moondream

# ── GPU 分級（CN-133）──────────────────────────────────────────
# auto（預設）＝啟動時用 nvidia-smi 判級；也可直接寫 4g／8g／16g。
# 分級只補「這裡沒寫的鍵」（VRAM 門檻、共存、畫布尺寸…），已寫的值永遠優先。實際採用值看 backend.log 的 [gpu-tier]。
# 4g：關 IPA／CN（改 img2img）／修臉／hires、畫布 832x1216；8g：關 IPA、hires 只用 latent 放大；16g：現行行為
GPU_TIER=auto

# ── Hires 第二段放大重繪（CN-134）──────────────────────────────
# 預設關；先用 ComfyUI 的 Anima_HiresFix_2pass／SDXL_V38_HiresFix_PAG 工作流 A/B 再開。倍率／denoise 依家族在 gen_profile.py
HIRES_ENABLED=false
# ComfyUI models/upscale_models/ 的檔名；留空或找不到檔 ⇒ 自動改用 latent 放大
HIRES_UPSCALE_MODEL=4x-AnimeSharp.safetensors

# ── LoRA 訓練設定（使用訓練功能時再填）────────────────────────
TRAINING_RUNNER_MODE=local
# KOHYA_PATH=C:\kohya_ss                          # kohya_ss 安裝路徑
# TRAINING_IMAGES_DIR=                            # 留空 = 自動用 data/training_images/
# COMFYUI_LORAS_DIR=C:\ComfyUI\models\loras       # ComfyUI LoRA 目錄

# ── Personal Style Preset（全域基準線 + 總開關，預設關閉）──────────────
# P5-6（2026-08-26）：畫風 tag 的優先序為
#   art_style.extra_tags（DB）> backend/prompt_profiles.yml 的 style_extra > 這裡 > 無。
#   已登錄 profile 的 workflow 吃不到這裡的值；這裡是未登錄 workflow 的基準線。
#   ⚠️ ENABLED=false 只關掉這一層，不影響 yml 的 style_extra。
# [已移除 CN-122] PERSONAL_STYLE_ENABLED=false
# [已移除 CN-122] PERSONAL_STYLE_EXTRA_TAGS=
# 畫風 tag 加權（!=1.0 才加權並前置到 identity 區塊）；profile 的
# style_extra_weight 優先於本值。
# PERSONAL_STYLE_WEIGHT=1.0
# PERSONAL_NEGATIVE_ENABLED=false
# PERSONAL_NEGATIVE=

# ── 個人標籤分家族（SYNC-007 軌 P，CN-115）─────────────────────────
# 鍵名：PERSONAL_STYLE_EXTRA_<家族>／PERSONAL_NEGATIVE_EXTRA_<家族>，家族＝PromptStyle 大寫
#   （ANIMA / ILLUSTRIOUS / SDXL / PONY / NOOBAI …，由 workflow 內嵌 checkpoint 判定）。
# 語義：疊加在家族畫風段／負向之後（不取代）；留空或不寫＝關閉；不受 PERSONAL_STYLE_ENABLED 節制。
# 權重／位置跟家族：illustrious（weight 1.0）接正向尾端；anima（weight 2.0）包成 (tag:2.0) 前置。
# 寫法：Anima 畫師加 @；括號要 \( \) 跳脫；illustrious 畫師不加 @（含 @ 會 warn-once）。
# [已移除 CN-122] PERSONAL_STYLE_EXTRA_ANIMA=<作品名>, @<畫師 tag>
# [已移除 CN-122] PERSONAL_STYLE_EXTRA_ILLUSTRIOUS=<作品名>, <畫師 tag>
# PERSONAL_NEGATIVE_EXTRA_ANIMA=(halo:1.5)
# PERSONAL_NEGATIVE_EXTRA_ILLUSTRIOUS=halo

# ── 內容安全 ──
# NSFW 護欄（預設 true）。false＝成人內容不過濾，debug 用；未成年護欄永遠生效、無開關。
# 每次剝除都會記一行 log：grep "nsfw-guard"
# NSFW_GUARD_ENABLED=true
# 回傳給前端的 PNG 去除內嵌 prompt／workflow（預設 true）；要把圖拖回 ComfyUI 讀 workflow 時設 false
# PNG_STRIP_METADATA=true

# ── 網路 ──
# 允許跨來源呼叫 API 的前端位址（逗號分隔）。後端與前端預設只綁 127.0.0.1，區網其他裝置連不到
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Tag 管理（設定 → 客製化標籤，CN-131）──
# Danbooru 標籤字典 CSV（唯讀，只供搜尋作品／繪師；tagcomplete 格式或有表頭格式皆可）。留空＝停用搜尋
# ComfyUI LoRA Manager 內建一份：<ComfyUI>\custom_nodes\comfyui-lora-manager\refs\danbooru_e621_merged.csv
# TAG_DICTIONARY_CSV=
# CUSTOM_TAGS_MAX_PER_KIND=1000
# CUSTOM_TAGS_IMPORT_MAX_BYTES=1048576
