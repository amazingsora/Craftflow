# Craftflow 環境設定
# 此檔不進 git（見 .gitignore）

# ── AI 服務位址 ────────────────────────────────────────────────
# 本機直跑（start.bat）用 localhost
# Docker 環境改為 host.docker.internal
OLLAMA_BASE=http://localhost:11434
COMFYUI_BASE=http://localhost:8188

# ── 模型選擇 ───────────────────────────────────────────────────
# 文字/視覺模型由「設定」UI 切換並持久化於 data/runtime_state.json，
# runtime_state 一律優先於此處。先前的 TEXT_MODEL/VISION_MODEL 已移除
# （值=llama3.2:3b/moondream 從不生效，被 runtime_state 覆寫，徒增誤導；
#  2026-06-20 盤點移除）。如需設「runtime_state 不存在時」的 fallback 再填。

# ── LoRA 訓練設定（使用訓練功能時再填）────────────────────────
TRAINING_RUNNER_MODE=local
# KOHYA_PATH=C:\kohya_ss                          # kohya_ss 安裝路徑
# TRAINING_IMAGES_DIR=                            # 留空 = 自動用 data/training_images/
# COMFYUI_LORAS_DIR=C:\ComfyUI\models\loras       # ComfyUI LoRA 目錄

# ── Personal Style Preset（預設關閉）──────────────────────────
PERSONAL_STYLE_ENABLED=true
PERSONAL_STYLE_EXTRA_TAGS=blue archive, blue archive style, flat color, clean lineart, anime style
# PERSONAL_NEGATIVE_ENABLED=false
# PERSONAL_NEGATIVE=
