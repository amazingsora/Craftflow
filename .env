# Craftflow 環境設定
# 此檔不進 git（見 .gitignore）

# ── AI 服務位址 ────────────────────────────────────────────────
# 本機直跑（start.bat）用 localhost
# Docker 環境改為 host.docker.internal
# 2026-09-20：改用 127.0.0.1 而非 localhost。localhost 在 Windows 會同時解析出
# ::1(IPv6) 與 127.0.0.1(IPv4)，而 Ollama / ComfyUI 預設只 bind IPv4 —— client
# 先試 ::1 失敗再退回 IPv4，每次呼叫多付一次連線成本。直接指 IPv4 省掉這一跳。
OLLAMA_BASE=http://127.0.0.1:11434
COMFYUI_BASE=http://127.0.0.1:8188

# ── 模型選擇 ───────────────────────────────────────────────────
# 文字/視覺模型由「設定」UI 切換並持久化於 data/runtime_state.json，
# runtime_state 一律優先於此處。先前的 TEXT_MODEL/VISION_MODEL 已移除
# （值=llama3.2:3b/moondream 從不生效，被 runtime_state 覆寫，徒增誤導；
#  2026-06-20 盤點移除）。如需設「runtime_state 不存在時」的 fallback 再填。

# ── LoRA 訓練設定（使用訓練功能時再填）────────────────────────
TRAINING_RUNNER_MODE=local
# KOHYA_PATH=C:\kohya_ss                          # kohya_ss 安裝路徑
# TRAINING_IMAGES_DIR=                            # 留空 = 自動用 data/training_images/
# ── SYNC-005 L3（2026-09-20）：本行原本是註解掉的，於是吃 config.py 的預設
#    C:\ComfyUI\models\loras —— 那個目錄在這台機器上**不存在**。
#    後果有兩個，都是靜默的：
#      1. workflow_builder._lora_arch() 讀不到 safetensors → 一律回 None →
#         「LoRA 架構與 checkpoint 不符」的健檢從頭到尾都在空轉（既有缺陷，今天才暴露）
#      2. lora_trigger_words() 讀不到 .civitai.info → 觸發詞永遠是空的，
#         軌 L 等於沒做（實證：#648/#649 掛了 LoRA，log 沒有「LoRA 觸發詞已補入正向」）
COMFYUI_LORAS_DIR=F:\wk\ComfyUI_portable\ComfyUI\models\loras

# ── Personal Style Preset（全域基準線 + 總開關）──────────────────────────
# P5-6（2026-08-26）角色轉變：本組值不再是畫風 tag 的唯一來源，而是
#   **全域預設值 ＋ kill switch**。優先序（character_design_service._resolve_style_extra）：
#     art_style.extra_tags（DB）> prompt_profiles.yml 的 style_extra > 這裡 > 無
#   四個主力 workflow（Standard_V37/V35、AnimaStandardV8/V8turbo）已在
#   backend/prompt_profiles.yml 登錄各自適配的配方 → 吃不到這裡的值；
#   這裡只作用於**未登錄 profile 的 workflow**（如 AnimaStandardV7）與新掛的工作流。
#   ENABLED=false 仍可一鍵關掉全部（含 profile 層？**不含** —— profile 層不受此開關
#   節制，要整組關畫風 tag 需同時清空 yml 的 style_extra）。
PERSONAL_STYLE_ENABLED=false
# 去 `blue archive` / `blue archive style`（P5-4：版權詞會把原創角色往具名角色拉，
# 且 image5 目標圖的畫風可用屬性 tag 描述，不需版權詞）。改為屬性 tag 組，取
# Illustrious 版配方（§4.2）中最保守、跨編碼器都算通用的三項當基準線。
# 2026-09-21：清空。理由見 backend/prompt_profiles.yml 的 anima anchor style_extra 註解。
# 本值是「未登錄 profile 的 workflow」的 fallback，且上面 PERSONAL_STYLE_ENABLED=false
# 時整條路徑不生效 ⇒ 本次清空是**防禦性**的，不是修正的必要條件：避免日後把 ENABLED
# 打開時靜默踩回這組平塗算子。現役 workflow 全數已登錄 profile
# （test_all_custom_workflows_are_registered 保證），實際影響面接近零。
# 回滾＝改回 `PERSONAL_STYLE_EXTRA_TAGS=flat color, cel shading, anime coloring`。
PERSONAL_STYLE_EXTRA_TAGS=
# A3 P1-4（2026-08-22，D4 死代碼修復）：預設未設 → config.py 取 1.0 → 
# character_design_service.py:698 走 else 分支，畫風 tag 不加權、append 到整串
# prompt 最尾端，被 ComfyUI chunk 稀釋（compiler.py:405-411 已註解過此後果）。
# 1.2 為起始值（非定案）：G1-3 機制設計的加權區間是 1.0(對照)/1.2/1.4，本值只是
# 把死代碼打開讓 A/B 有基準可比；正式權重待 A/B 後定案。
# P5-6（2026-08-26）：本值同樣降為**全域基準線**——四個主力 workflow 的權重改由
# prompt_profiles.yml 的 style_extra_weight 決定（Illustrious 1.2 / Anima 2.0，
# 理由：兩種文字編碼器的權重量級不同）。原 P5-1 全域三檔位 A/B 已併入 P5-10。
PERSONAL_STYLE_WEIGHT=1.2
# PERSONAL_NEGATIVE_ENABLED=false
# PERSONAL_NEGATIVE=

# ── VRAM / 慢任務（SYNC-006 N14，2026-09-20）──────────────────────────────────
# 以下四項的預設值已寫在 core/config.py，這裡只列出來方便調參與回滾。
# 全部維持預設就不必取消註解。
#
# 起因：ComfyUI 在 --highvram 下對 /free 不放模型（實測 7/7 次 reserved 沒降），
# 而舊版 vram_manager 送完 /free 只隔 2ms 就回讀 → 假警報 → 照樣放行 Ollama 去
# 載 9B，當下 free 只有 0.0~0.9G → 驅動把 ComfyUI 權重頁擠進共享系統記憶體 →
# 主 KSampler 2.64 it/s 掉到 12.69 s/it（33×）。詳見 doc/2026-09-20_開發記錄.md N14。
#
# /free 後等 reserved 真的下降的秒數。0 = 不等（回到 2026-09-20 之前的行為）
# VRAM_FREE_WAIT_SEC=5
# VRAM_FREE_POLL_SEC=0.25
# true = ComfyUI 沒讓出顯存就不轉移 focus 到 ollama（會讓該次 LLM 呼叫失敗，
#        但保住 ComfyUI 不被擠出 VRAM）。先觀察 log 再決定要不要開。
# VRAM_STRICT_FREE=false
# Ollama 模型用完後在 VRAM 停留秒數。0 = 立刻退；-1 = 交還 Ollama 預設（5 分鐘）
# OLLAMA_KEEP_ALIVE_SEC=0
# 生圖任務超過此秒數就在 backend.log 記 error + 當下顯存。基準：正常 44~56s。0 = 停用
# COMFYUI_SLOW_JOB_WARN_SEC=150
