# Craftflow 環境設定
# 此檔不進 git（見 .gitignore）

# ── AI 服務位址 ────────────────────────────────────────────────
# 本機直跑（start.bat）用 localhost
# Docker 環境改為 host.docker.internal
OLLAMA_BASE=http://localhost:11434
COMFYUI_BASE=http://localhost:8188

# ── 模型選擇（啟動預設；前端「設定」頁可即時切換）──────────────
# 省略 = 使用程式內建預設（llama3.2:3b / moondream）
# 依 VRAM 參考 doc/setup_guide.md 硬體對照表
TEXT_MODEL=llama3.2:3b
VISION_MODEL=moondream

# ── LoRA 訓練設定（使用訓練功能時再填）────────────────────────
TRAINING_RUNNER_MODE=local
# KOHYA_PATH=C:\kohya_ss                          # kohya_ss 安裝路徑
# TRAINING_IMAGES_DIR=                            # 留空 = 自動用 data/training_images/
# COMFYUI_LORAS_DIR=C:\ComfyUI\models\loras       # ComfyUI LoRA 目錄

# ── Personal Style Preset（預設關閉）──────────────────────────
# PERSONAL_STYLE_ENABLED=false
# PERSONAL_STYLE_EXTRA_TAGS=
# PERSONAL_NEGATIVE_ENABLED=false
# PERSONAL_NEGATIVE=
